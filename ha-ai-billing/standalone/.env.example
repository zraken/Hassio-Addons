# mqtt-tokens environment — copy to .env and fill in.
# Any provider key left empty simply disables that account (no error).

# ===== MQTT broker =========================================================
# The broker Home Assistant already uses. If you run the Mosquitto broker
# add-on, this is usually the host running HA.
MQTT_HOST=
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
# Optional: path to a CA cert for TLS (inside this directory). Leave empty
# for plaintext; port 8883 alone also enables TLS with system CAs.
MQTT_CA_CERT=
# Escape hatch for self-signed/private-CA broker certs when you don't want to
# mount the CA: skips certificate verification entirely (LAN-only tradeoff).
# MQTT_TLS_INSECURE=true

# ===== Provider API keys ===================================================
# OpenRouter: MANAGEMENT key required for the balance endpoint — create at
# https://openrouter.ai/settings/management-keys (separate page from regular
# keys; read-only scope is sufficient). Note: management keys expire, and an
# expired one shows up as auth_error "API key expired".
OPENROUTER_API_KEY=

# DeepSeek: normal API key from https://platform.deepseek.com
DEEPSEEK_API_KEY=

# OpenAI: ADMIN key required for the usage/costs endpoints — create at
# https://platform.openai.com/settings/organization/admin-keys (Settings →
# Organization → Admin keys). Value starts sk-admin-... and is shown once.
# Needs org owner/admin role; admin keys don't work for inference.
OPENAI_ADMIN_KEY=

# Anthropic: Admin API key (sk-ant-admin...) from the Claude Console →
# Organization settings. Organization accounts only — personal accounts are
# not supported by Anthropic's Admin API.
ANTHROPIC_ADMIN_KEY=

# Gemini: normal AI Studio API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Meta Model API: normal key from https://dev.meta.ai
META_API_KEY=

# z.ai GLM Coding Plan: the key you use in Claude Code / coding tools
ZAI_PLAN_API_KEY=

# z.ai / Zhipu pay-as-you-go balance (EXPERIMENTAL endpoint)
ZAI_API_KEY=

# ===== Optional runtime tuning =============================================
# Prefix for Home Assistant device/entity display names (e.g. "ai-billing-")
# so everything is searchable with one term. Can also be set in config.yaml
# (name_prefix:) — the YAML value wins when both are set.
# NAME_PREFIX=ai-usage-
# POLL_INTERVAL=300
# LOG_LEVEL=INFO
